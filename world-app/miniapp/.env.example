# Mini App configuration. Copy to `.env` (Vite reads VITE_* at build time).

# The AgentKit x402 gateway the agent calls (world-app/gateway). The dev gateway
# defaults to this; set it for any non-local deployment.
VITE_GATEWAY_URL=http://localhost:8787

