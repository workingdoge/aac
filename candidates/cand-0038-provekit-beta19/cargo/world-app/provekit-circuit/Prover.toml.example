# Prover.toml.example -- a CONCRETE witness for the right-sized receipt.
#
# Copy to `Prover.toml` and run `nargo execute` (beta.19). The public commitment
# values below were regenerated via `nargo test --show-output print_public_inputs`
# under the Poseidon2 SPONGE hash (public std::hash::poseidon2_permutation, see
# src/hash.nr). They WILL change once the hash is switched to Skyscraper at
# integration -- recompute them the same way.
#
# Private witness:
usd_cents = "10000"
fabric_meters = "50"
buyer_id = "111"
supplier_id = "222"

# Public inputs (recomputed under the sponge hash):
rulebook_id = "7"
event_commitment_pub = "0x22dde87bb42e2c0578693c0cc412f172b8ebd73de6201941f8eed299685a6d5a"
participant_set_pub = "0x021921c7e8447cf219adbc507e8731fc648f7d9927c5333b1f5eca25ec0c4772"
journal_commitment_pub = "0x1bd134b20563b6f8e23129e7af09640e7024b7ef5fe4619807b07f8fdab896e2"
event_nullifier_pub = "0x15ab1d0a52937434c8867e788be418a99d103322f114a67be8a8e01b3663daa0"
