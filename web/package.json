{
  "name": "aac-web",
  "type": "module",
  "private": true,
  "scripts": {
    "sync-specs": "node scripts/sync-specs.mjs",
    "dev": "node scripts/sync-specs.mjs && astro dev",
    "build": "node scripts/sync-specs.mjs && astro build",
    "deploy:dry-run": "bash scripts/deploy-cloudflare.sh --dry-run",
    "deploy": "bash scripts/deploy-cloudflare.sh --execute",
    "preview": "astro preview --host"
  },
  "dependencies": {
    "@astrojs/starlight": "0.37.7",
    "astro": "5.18.0",
    "lit": "^3.3.3",
    "sharp": "0.33.5"
  }
}
