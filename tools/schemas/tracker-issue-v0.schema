# tracker.issue.v0
#
# Runtime owner: Loop tracker realization.
# Law realized: premath.issue-formation.v0.
#
# File layout:
#   ${BOAT_TRACKER_ROOT}/issues/<id>.json
#
# Required JSON object fields:
#   id             string; IssueId, issue:<scope-token>:<positive ordinal>
#   scope          string; workspace | instance:<instance-token>
#   title          non-empty single-line string
#   body           non-empty string; may contain paragraphs
#   kind           task | decision | obstruction
#   priority       P1 | P2 | P3
#   provenanceRefs array of formed provenance refs:
#                    candidate(number=N, slug=slug)
#                    statement(statement-id)
#                    external(opaque-string)
#   createdBy      identity.presentation:* reference
#   deps           array of syntactic IssueId strings
#   holderToBe     non-empty string
#   acceptance     non-empty string
#
# Tracker-local extension fields:
#   comments       array of proposal-side annotations; ignored by status fold
#   depAdds        array of proposal-side dependency mutation notes
#
# Forbidden by convention:
#   status         tracker.sh never writes or consults a stored status field;
#                  current status is derived only from events.jsonl.
