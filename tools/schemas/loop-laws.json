{
  "schema": "boat.loop-laws.v0",
  "_comment": [
    "Laws-as-data for the loop model (premath.loop-model.v0 LM-1.3).",
    "DECLARED REDUNDANCY with tools/loop: the validate law sequence,",
    "auto gate chain, reflect decision table, and scores_verdict",
    "contract are restated here as the program tools/loop-model.py",
    "interprets. Drift between this file and tools/loop is surfaced by",
    "tools/loop-model-diff.sh as model_coherence_failure and reconciled",
    "deliberately — never silently, in either direction. RJ-1.6: this",
    "file is a compiled artifact, data for its consumers, never",
    "executable authority."
  ],
  "registries": {
    "status_vocab": "tools/schemas/status.vocab",
    "failure_classes": "tools/schemas/failure-classes.tsv",
    "receipt_schema_dir": "tools/schemas"
  },
  "validate": {
    "doc_schema": "boat.validate.v0",
    "failed_judgment": "candidate-record validation",
    "admitted_judgment": "candidate-record formation checks (premath.record-judgments.v0 shaped)",
    "witness_ref_files": ["META", "DECLARATION", "LANDING"],
    "status_transition": {"from": "open", "to": "validated"},
    "landed_status_guard": {
      "statuses": ["landed"],
      "rc": 70,
      "message": "validate is pre-land and preserves existing VALIDATE.json for landed records; use tools/eval/evaluate-landed.sh for post-land conformance"
    },
    "meta_required_keys": ["candidate_id", "cycle_id", "opened", "intent", "status"],
    "laws": [
      {"id": "VAL-README", "kind": "file-exists", "path": "README.md",
       "class": "record-formation-incomplete", "token": "README.md",
       "reason": "missing README.md"},
      {"id": "VAL-META-KEYS", "kind": "meta-required-keys",
       "class": "record-formation-incomplete", "token": "META.{key}",
       "reason": "META missing key: {key}"},
      {"id": "VAL-META-ID", "kind": "meta-equals-dirname", "key": "candidate_id",
       "class": "record-formation-incomplete", "token": "META.candidate_id",
       "reason": "META candidate_id does not match directory name"},
      {"id": "VAL-STATUS-VOCAB", "kind": "vocab-member", "key": "status",
       "vocab": "status_vocab", "skip_if_value_empty": true, "skip_if_vocab_absent": true,
       "class": "vocabulary-atom-failure", "token": "META.status",
       "reason": "status out of vocabulary: {value}"},
      {"id": "VAL-LANDING", "kind": "landing-lines", "file": "LANDING", "line_laws": [
        {"check": "src-exists", "class": "record-formation-incomplete",
         "token": "LANDING", "reason": "LANDING source missing: {src}"},
        {"check": "dest-nonempty", "class": "record-formation-incomplete",
         "token": "LANDING", "reason": "LANDING entry for {src} has no destination"},
        {"check": "dest-rooted", "class": "verifier_contract_violation",
         "token": "LANDING", "reason": "LANDING destination must be root-relative without ..: {dest}"}]},
      {"id": "VAL-DECL", "kind": "declaration", "file": "DECLARATION",
       "missing": {"class": "record-formation-incomplete", "token": "DECLARATION",
                   "reason": "missing DECLARATION (required since PREMATH-0003)"},
       "todo_marker": "TODO",
       "todo": {"class": "record-formation-incomplete", "token": "DECLARATION",
                "reason": "DECLARATION incomplete (TODO present)"},
       "keys": ["layer", "implements", "preserves"],
       "key_missing": {"class": "record-formation-incomplete", "token": "DECLARATION.{key}",
                       "reason": "DECLARATION missing key: {key}"},
       "key_empty": {"class": "record-formation-incomplete", "token": "DECLARATION.{key}",
                     "reason": "DECLARATION key has empty value: {key}"},
       "layer_vocab": ["doctrine", "theory", "model", "evidence-tooling", "artifact"],
       "layer_bad": {"class": "vocabulary-atom-failure", "token": "DECLARATION.layer",
                     "reason": "DECLARATION layer out of vocabulary: {value}"},
       "preserves_none": "none",
       "preserves_unknown_pattern": "^unknown\\([^\\)]+\\)$",
       "preserves_registry": ["dm.identity", "dm.refine.context", "dm.refine.cover",
                              "dm.transport.world", "dm.transport.location",
                              "dm.profile.execution", "dm.profile.evidence",
                              "dm.policy.rebind", "dm.presentation.projection",
                              "dm.commitment.attest"],
       "preserves_bad": {"class": "vocabulary-atom-failure", "token": "DECLARATION.preserves",
                         "reason": "DECLARATION preserves token out of registry: {tok}"}},
      {"id": "VAL-SCORES", "kind": "scores-block", "file": "scores.json", "block_laws": [
        {"check": "has-substring", "needle": "\"evaluated_at\"",
         "class": "record-formation-incomplete", "token": "scores.json.evaluated_at",
         "reason": "scores.json missing evaluated_at"},
        {"check": "has-substring", "needle": "\"task\"",
         "class": "record-formation-incomplete", "token": "scores.json.task",
         "reason": "scores.json missing task"},
        {"check": "attest-verify-if-provenance", "guard_substring": "\"provenance\"",
         "class": "sigma-missing-witness", "token": "scores.json.provenance",
         "reason": "scores.json provenance verification FAILED"}]},
      {"id": "VAL-DRAFTS", "kind": "drafts-receipts", "glob": "drafts/*.md",
       "class": "record-formation-incomplete", "token": "drafts",
       "reason": "drafts/*.md failed receipt-schema-check"},
      {"id": "VAL-EVAL-HARNESS-FORM", "kind": "eval-harness-lint",
       "path": "eval-self.sh", "tool": "tools/eval/harness-lint.sh",
       "class": "verifier_contract_violation", "token": "eval-self.sh",
       "reason": "evaluator harness has {errors} verifier-contract lint error(s) (harness-lint; see emitted class message)"}
    ]
  },
  "scores_verdict": {
    "contract": ["pass", "", "MALFORMED-JSON", "<json-quoted>"],
    "pass_token": "pass",
    "malformed_token": "MALFORMED-JSON",
    "absent_surface_token": "no-scores"
  },
  "auto": {
    "chain": [
      {"gate": "scores-exists", "refusal": "refused-unevaluated",
       "ground_truth_match": "auto refuses unevaluated"},
      {"gate": "verdict-not-malformed", "refusal": "refused-verdict-malformed",
       "ground_truth_match": "auto refuses malformed evidence"},
      {"gate": "verdict-pass", "refusal": "refused-verdict-nonpass",
       "ground_truth_match": "auto refuses non-pass evidence"},
      {"gate": "provenance-present", "refusal": "refused-unattested",
       "ground_truth_match": "no provenance block"},
      {"gate": "attest-verify", "refusal": "refused-attest-verify",
       "ground_truth_match": "attestation verification FAILED"},
      {"gate": "validate-admitted", "refusal": "refused-validate",
       "ground_truth_match": "auto refuses invalid candidates"},
      {"gate": "not-already-landed", "refusal": "refused-already-landed",
       "ground_truth_match": "is already landed"},
      {"gate": "landing-dests-valid", "refusal": "refused-landing-invalid",
       "ground_truth_match": "LANDING destination invalid"},
      {"gate": "landing-nonempty", "refusal": "refused-nothing-to-land",
       "ground_truth_match": "nothing to land"},
      {"gate": "tier-review", "refusal": "refused-tier-guard",
       "ground_truth_match": "REVIEW.md is required"},
      {"terminal": "landed", "ground_truth_match": "auto complete"}
    ],
    "landing_default_rule": {"glob": "*.sh", "exclude": ["eval-self.sh"], "dest_prefix": "tools/"},
    "tier_patterns": ["tools/", "sites/premath/specs/", "sites/premath/statements/"]
  },
  "reflect": {
    "table": [
      {"when": "no-scores", "assessment": "obstruction-proposal",
       "basis": "no evaluation evidence exists; the loop ran without Evaluate()"},
      {"when": "provenance-invalid", "assessment": "obstruction-proposal",
       "basis": "attestation verification FAILED — scores, traces, or harness do not match the recorded chain; evidence may be edited or stale"},
      {"when": "unattested", "assessment": "obstruction-proposal",
       "basis": "evidence is unattested (no provenance block); re-run the evaluator so reflect can trust scores.json"},
      {"when": "verdict-malformed", "assessment": "obstruction-proposal",
       "basis": "scores.json is not parseable JSON — fail closed: an unreadable (or substring-smuggled) verdict cannot witness; re-run the evaluator"},
      {"when": "verdict-pass", "assessment": "witness",
       "basis": "verdict pass (top-level JSON key); evidence attested (chain over scores body, traces, harness)"},
      {"when": "verdict-other", "assessment": "obstruction-proposal",
       "basis": "recorded verdict is not pass; see scores.json and traces/"},
      {"when": "verdict-mentioned-not-top-level", "assessment": "obstruction-proposal",
       "basis": "scores.json mentions a verdict but has no top-level string verdict key; refusing to witness by substring — see scores.json"},
      {"when": "recalls-all-one", "assessment": "witness",
       "basis": "all per-class recalls are 1.0 across slices (vs constant-admit baseline); evidence attested"},
      {"when": "recalls-fallthrough", "assessment": "obstruction-proposal",
       "basis": "recall below 1.0, missing, or unparseable on at least one class/slice; see scores.json"},
      {"when": "rolled-back-override", "assessment": "obstruction-proposal",
       "basis": "cargo was rolled back after landing; the gap that forced withdrawal is the proposal"}
    ],
    "recall_exclude_substring": "baseline_constant_admit",
    "recall_pattern": "\"(admit|deny)_recall\": *[0-9.]+",
    "recall_one_pattern": "^1(\\.0*)?$"
  }
}
